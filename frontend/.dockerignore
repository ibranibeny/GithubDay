# Keep the host's installed modules and previous build output out of the build
# context so `npm ci` decides the dependency tree, not the developer's laptop.
node_modules/
dist/
coverage/
playwright-report/
test-results/

.env
.env.*

# Do not ignore Dockerfile/.dockerignore here: az acr build uploads this context
# as a tarball honoring this file, so excluding them fails with "Unable to find 'Dockerfile'".
