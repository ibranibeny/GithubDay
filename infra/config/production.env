# Azure Cost Copilot - production environment (non-secret names only).
#
# Loaded by infra/scripts/lib.sh (load_config); values already present in the
# process environment win. Never put secrets in this file - the deployment
# workflows read secrets from GitHub Environment secrets instead.

# Label surfaced in the UI and attached to telemetry.
APP_ENVIRONMENT=production

# GitHub Environment that guards deployments to this Azure environment.
GITHUB_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Shared (subscription-wide) resources.
# These four values MUST stay identical in staging.env and production.env;
# preflight.sh fails when they drift.
# ---------------------------------------------------------------------------

SHARED_RESOURCE_GROUP=rg-cost-copilot-shared

# Azure Container Registry names are globally unique, 5-50 alphanumeric
# characters. The subscription prefix keeps this one collision-resistant.
ACR_NAME=crcostcopilot439cf6ec

# Front Door Premium profile that fronts both environments.
AFD_PROFILE_NAME=afd-cost-copilot

# ---------------------------------------------------------------------------
# Environment-specific resources.
# ---------------------------------------------------------------------------

RESOURCE_GROUP=rg-cost-copilot-production
ACA_ENVIRONMENT_NAME=cae-cost-copilot-production

# Container App names are limited to 32 characters.
FRONTEND_APP_NAME=ca-cc-frontend-production
BACKEND_APP_NAME=ca-cc-backend-production

LOG_ANALYTICS_NAME=log-cost-copilot-production
APP_INSIGHTS_NAME=appi-cost-copilot-production

# User-assigned managed identities.
DEPLOY_IDENTITY_NAME=id-cost-copilot-deploy-production
BACKEND_IDENTITY_NAME=id-cost-copilot-backend-production
FRONTEND_IDENTITY_NAME=id-cost-copilot-frontend-production

# Networking (Container Apps needs a dedicated /23 infrastructure subnet).
VNET_NAME=vnet-cost-copilot-production
VNET_ADDRESS_PREFIX=10.30.0.0/16
ACA_SUBNET_NAME=snet-aca-infra
ACA_SUBNET_PREFIX=10.30.0.0/23
PRIVATE_ENDPOINT_SUBNET_NAME=snet-private-endpoints
PRIVATE_ENDPOINT_SUBNET_PREFIX=10.30.2.0/24

# Front Door endpoint. The public hostname is <endpoint>-<hash>.z01.azurefd.net,
# so the endpoint name only has to be unique inside the profile.
AFD_ENDPOINT_NAME=cost-copilot-production

# Origin groups, origins and routes created by configure-frontdoor.sh. Both
# environments share one Front Door profile, so every one of these names has to
# carry the environment.
AFD_FRONTEND_ORIGIN_GROUP_NAME=og-frontend-production
AFD_BACKEND_ORIGIN_GROUP_NAME=og-backend-production
AFD_FRONTEND_ORIGIN_NAME=origin-frontend-production
AFD_BACKEND_ORIGIN_NAME=origin-backend-production
AFD_FRONTEND_ROUTE_NAME=route-frontend-production
AFD_BACKEND_ROUTE_NAME=route-api-production
AFD_HEALTH_ROUTE_NAME=route-health-production

# ---------------------------------------------------------------------------
# Filled in after bootstrap / provisioning - intentionally empty here.
# The deployment workflows read the authoritative copies from GitHub
# Environment variables, which bootstrap-oidc.sh writes with `gh variable set`.
# ---------------------------------------------------------------------------

# Set by infra/scripts/bootstrap-oidc.sh (Entra ID app registrations).
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=

# Client ID of DEPLOY_IDENTITY_NAME; set by infra/scripts/bootstrap-oidc.sh.
DEPLOY_CLIENT_ID=

# Generated by Azure when the Front Door endpoint is created in Task 12/13.
# Re-run bootstrap-oidc.sh afterwards to register the SPA redirect URI.
FRONTDOOR_HOSTNAME=
