# Azure Cost Copilot - example environment configuration.
# Copy to backend/.env (backend) or export in the container environment (frontend).
# Never commit real values; every entry below is intentionally empty or a placeholder.

# ---------------------------------------------------------------------------
# Backend (FastAPI, read by pydantic-settings; names are case-insensitive)
# ---------------------------------------------------------------------------

# Entra ID tenant that issues access tokens.
AZURE_TENANT_ID=

# Subscription the cost queries are fixed to.
AZURE_SUBSCRIPTION_ID=

# Optional user-assigned managed identity client ID. Leave empty to use the
# system-assigned identity or the local developer credential.
AZURE_CLIENT_ID=

# Application (client) ID of the backend API app registration. Used as the
# expected audience when validating bearer tokens.
ENTRA_API_CLIENT_ID=

# Microsoft Foundry endpoint, for example https://example.openai.azure.com
FOUNDRY_ENDPOINT=

# Model deployment name served by the Foundry endpoint.
FOUNDRY_DEPLOYMENT=gpt-5.4-mini

# Application Insights connection string. Leave empty to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Comma-separated list of browser origins allowed to call the API.
# A wildcard (*) is rejected at startup; list every origin explicitly.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (injected into config.template.js at container startup)
# ---------------------------------------------------------------------------

# Environment label shown in the UI and attached to telemetry, e.g. dev or prod.
APP_ENVIRONMENT=dev

# Entra ID tenant used by MSAL in the browser.
ENTRA_TENANT_ID=

# Application (client) ID of the single-page application registration.
ENTRA_SPA_CLIENT_ID=

# Base URL of the backend API, for example https://localhost:8000
API_BASE_URL=http://localhost:8000

# The frontend also consumes ENTRA_API_CLIENT_ID and
# APPLICATIONINSIGHTS_CONNECTION_STRING, both defined in the backend section above.
